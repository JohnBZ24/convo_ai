{
  "expo": {
    "name": "Convo AI",
    "slug": "convo-ai",
    "scheme": "convoai",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#202123",
    "android": {
      "package": "com.abiroot.convoai",
      "adaptiveIcon": {
        "backgroundColor": "#202123"
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "imageWidth": 180,
          "backgroundColor": "#202123",
          "resizeMode": "contain"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
