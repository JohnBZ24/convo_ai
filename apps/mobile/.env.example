# Copy to .env. Metro INLINES EXPO_PUBLIC_* at bundle time, so a change here
# needs a Metro restart, not just a reload.

# Where the API is, as seen BY THE PHONE.
#
#   over Wi-Fi (how the demo runs):  http://<this machine's LAN IP>:3000
#   over USB with `adb reverse`:     http://127.0.0.1:3000   (the built-in default)
#
# Find the LAN address with `ipconfig` - it is the Wi-Fi adapter's IPv4. It is a
# DHCP lease, so it can change between sessions; if sign-in starts failing with
# "Network request failed", check this first.
EXPO_PUBLIC_API_BASE_URL=http://192.168.1.10:3000
