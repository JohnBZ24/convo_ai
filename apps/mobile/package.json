{
  "name": "@convo/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android --device",
    "prebuild": "expo prebuild --platform android",
    "lint": "biome check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "doctor": "expo-doctor"
  },
  "dependencies": {
    "@config-plugins/react-native-webrtc": "^15.0.2",
    "@convo/ai": "workspace:*",
    "@convo/shared": "workspace:*",
    "@shopify/flash-list": "2.0.2",
    "@tanstack/react-query": "^5.102.8",
    "expo": "57.0.18",
    "expo-linking": "~57.0.8",
    "expo-network": "~57.0.1",
    "expo-router": "~57.0.17",
    "expo-secure-store": "~57.0.2",
    "expo-splash-screen": "~57.0.8",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.3",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-enriched-markdown": "^1.0.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-incall-manager": "^4.2.2",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.2",
    "react-native-streamdown": "^0.2.0",
    "react-native-webrtc": "^124.0.8",
    "react-native-worklets": "0.10.1",
    "remend": "^1.3.1",
    "zustand": "^5.0.15"
  },
  "worklets": {
    "staticFeatureFlags": {
      "BUNDLE_MODE_ENABLED": true
    }
  },
  "devDependencies": {
    "@types/react": "~19.2.18",
    "expo-doctor": "^1.20.4",
    "typescript": "7.0.2",
    "vitest": "^4.1.11"
  },
  "expo": {
    "autolinking": {
      "android": {
        "buildFromSource": [
          "react-native-worklets"
        ]
      }
    },
    "install": {
      "exclude": [
        "@shopify/flash-list",
        "typescript"
      ]
    }
  }
}
