# Copy to .env and fill in. Vite loads this from apps/server/, NOT the repo root.
# Blank values arrive as empty strings, not undefined - lib/env.ts has an
# optional() helper that treats "" as absent.

# ---- runtime ----
NODE_ENV=development
PORT=3000
APP_VERSION=0.1.0

# ---- database ----
DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/convo

# ---- openai ----
# Server-only. Exchanged at POST /v1/realtime/client_secrets for an ephemeral
# credential. This key never reaches the device.
OPENAI_API_KEY=sk-...
REALTIME_MODEL=gpt-realtime-2.1-mini
REALTIME_VOICE=marin

# ---- auth ----
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# ---- docs ----
# Gates GET /api/openapi and GET /api/docs. Off means 404.
DOCS_ENABLED=true
