# Copy to .env and fill in. Vite loads this from apps/server/, NOT the repo root.
# Blank values arrive as empty strings, not undefined - config/env.ts has a
# blankToUndefined preprocessor that treats "" as absent so defaults apply.

# ---- runtime ----
NODE_ENV=development
PORT=3000
APP_VERSION=0.1.0

# ---- database ----
DATABASE_URL=postgres://user:password@127.0.0.1:5432/convo

# ---- openai ----
# Server-only. Exchanged at POST /v1/realtime/client_secrets for an ephemeral
# credential. This key never reaches the device.
OPENAI_API_KEY=sk-...

# Where the realtime endpoints live. Override to point at a proxy, a regional
# host or a local mock; the device is TOLD the matching /realtime/calls URL, so
# both halves of the flow move together.
OPENAI_BASE_URL=https://api.openai.com/v1

# Any id from GET /v1/models. Verified live on 25 Aug 2026: gpt-realtime,
# gpt-realtime-1.5, gpt-realtime-2, gpt-realtime-2.1, gpt-realtime-2.1-mini.
# Switching to a mini variant is this one line - no redeploy, no code change.
REALTIME_MODEL=gpt-realtime-2

# One of: alloy, ash, ballad, cedar, coral, echo, marin, sage, shimmer, verse.
# Validated at boot, so a typo fails here rather than at mint time.
REALTIME_VOICE=marin

# How long a minted credential lives, in seconds. The API accepts 10-7200.
# Short on purpose: it only has to survive establishing the WebRTC connection,
# which then outlives it.
REALTIME_CLIENT_SECRET_TTL_SECONDS=60

# A hung mint leaves the user staring at a spinning orb. 1000-60000.
OPENAI_REQUEST_TIMEOUT_MS=10000

# ---- auth ----
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://127.0.0.1:3000

# ---- docs ----
# Gates GET /api/openapi and GET /api/docs. Off means 404.
DOCS_ENABLED=true
