# @tanstack/react-start declares @rsbuild/core as a hard peer even on the Vite
# path, which would otherwise fail the install. Warn instead of erroring.
strict-peer-dependencies=false

# Be tolerant of flaky tarball fetches.
fetch-retries=5
fetch-retry-mintimeout=10000
fetch-retry-maxtimeout=120000
fetch-timeout=180000
